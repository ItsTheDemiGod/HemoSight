{"nodes": [{"id": "docs_archive_decision_log_decision_log", "label": "DECISION LOG (section 7)", "file_type": "document", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Append-only canonical chronological record of every design decision, deviation and changed assumption, 2026-09-10 onward."}, {"id": "docs_archive_decision_log_imaging_arm_closed", "label": "Decision 2026-09-11: imaging arm CLOSED, not to be reopened", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four approaches on 100 subjects, 3 devices, 3 lighting; any future citation must cite the imaging arm as a negative result with mechanism, never as a method."}, {"id": "docs_archive_decision_log_ppg_promoted_co_primary", "label": "Decision 2026-09-11: PPG arm promoted to co-primary", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four narrow wavelengths and a controlled LED source: the illuminant-estimation error term does not exist. Scope change only."}, {"id": "docs_archive_decision_log_phase6_audit_harness_not_conformal", "label": "Decision 2026-09-12: Phase 6 is an audit harness, not conformal prediction", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no estimator to wrap. Literature survey found 0 of 5 sources reporting a demographic baseline or duplicate check; each such check is already implemented here. Wrapped existing modules (hashing, splits, Gate B baseline), not rewritten, because duplicated statistical routines drift invisibly."}, {"id": "docs_archive_decision_log_positive_claim_survives_hardening", "label": "Decision 2026-09-11: the positive claim survives hardening", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selection-aware permutation chosen over a Bonferroni-style correction because it reflects the procedure that produced the claim and needs no assumption about configuration correlation. Uselessness attached as a mandatory clause."}, {"id": "docs_archive_decision_log_claim_hierarchy_restructured", "label": "Decision 2026-09-11: claim hierarchy restructured (N3+N4 primary, N1 secondary negative)", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_decision_log_n1_restructured_n1abc", "label": "Decision 2026-09-11: N1 restructured into N1a/N1b/N1c", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two largest conjunctiva datasets are pre-segmented cutouts with the sclera removed, so N1 cannot be one end-to-end claim."}, {"id": "docs_archive_decision_log_ghana_binary_label_only", "label": "Decision 2026-09-11: Ghana pool is binary-label-only; hb_label_trusted enforced", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_decision_log_melanin_catastrophic_confounder", "label": "Decision 2026-09-11: melanin is a catastrophic confounder (N5 finding in Phase 3)", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Melanin fraction 0.005 shifts recovered Hb by +9.6 g/dL with the illuminant held perfect."}, {"id": "docs_archive_decision_log_controlled_capture_outcome_b", "label": "Decision 2026-09-12: controlled-capture hypothesis tested; outcome B", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refutation restated in two parts: not recoverable uncontrolled; MARGINAL at best under controlled capture. Contained the later-retired phrase 'moves no clinical threshold'."}, {"id": "docs_archive_decision_log_claude_md_split", "label": "Decision 2026-09-17: CLAUDE.md split into header plus docs/archive", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_decision_log_phase9a_correction_moves_no_threshold", "label": "Correction 2026-09-17: 'moves no clinical threshold' too strong; imaging WEAKENED within site", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_decision_log_external_audit_availability_result", "label": "Decision 2026-09-13: external audit run; availability is the result", "file_type": "concept", "source_file": "docs/archive/decision_log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_archive_decision_log_decision_log", "target": "docs_archive_decision_log_imaging_arm_closed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/decision_log.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_decision_log_imaging_arm_closed", "target": "claude_imaging_arm_closed_final", "relation": "rational