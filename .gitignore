# Datasets are never committed. data/raw is READ-ONLY source material.
# The project's data tree only (anchored): datasets, interim artefacts, synthetic corpora.
# app/frontend/src/data/ holds small generated JSON (public physics, aggregate results) and
# is deliberately tracked - a clone cannot build the front end without it.
/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Model artefacts
*.pth
*.pt
*.onnx
*.ckpt
*.safetensors

# Figures are DATASET-DERIVED IMAGERY. 9 of 10 dataset licences are unverified
# (reports/phase1_dataset_licences.md), so rendered dataset pixels must not be
# committed. Every figure is regenerable: see reports/README.md.
reports/figures/

# Node / frontend
node_modules/
dist-ssr/
*.local

# Experiment outputs (file-based tracking; keep the logs in CLAUDE.md instead)
runs/
mlruns/
logs/
*.db

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Frontend build artefacts (Phase 6)
*.tsbuildinfo
